# ZentarNetwork Discord Botu — örnek yapılandırma.
# Bu dosyayı ".env" adıyla kopyalayın ve değerleri doldurun. .env dosyasını ASLA paylaşmayın.

# --- Discord ---
DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# --- MongoDB ---
MONGODB_URI=mongodb://127.0.0.1:27017/zentarnetwork

# --- Minecraft sunucusu (durum sorgusu için) ---
MC_HOST=mc.zentarnetwork.com
MC_PORT=25565
MC_STATUS_INTERVAL_SEC=30

# --- Minecraft eklentisi köprüsü (WebSocket) ---
# Eklenti bota bu adrese bağlanır. Aynı makinedeyse 127.0.0.1 bırakın.
MC_BRIDGE_HOST=127.0.0.1
MC_BRIDGE_PORT=8765
# En az 32 karakter, rastgele. Üretmek için: node scripts/generate-secret.js
# Aynı değer eklentinin config.yml dosyasındaki "secret" alanına yazılmalıdır.
MC_BRIDGE_SECRET=WKHCDjxgvs4I4ix13fdaRXOmnkdl943iHS_SK4ZHKHsAdu4VWWuOxuo9NL-_-SqK

# --- Genel ---
LOG_LEVEL=info
# İsteğe bağlı görseller (embed marka görselleri)
BRAND_BANNER_URL=
BRAND_ICON_URL=
